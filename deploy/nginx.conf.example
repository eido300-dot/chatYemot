# Merge into your existing HTTPS server block; configure certificates separately.
# Create a dedicated domain virtual host in the existing web server.
# Do not replace Webmin-managed configuration without inspecting it.
# Replace BOTH CHATYEMOT_PORT placeholders with the selected free local port.
# This fragment is not valid until those placeholders are replaced.
client_max_body_size 13m;
location ^~ /ivr/ {
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://127.0.0.1:CHATYEMOT_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 70s;
}
location / {
    proxy_pass http://127.0.0.1:CHATYEMOT_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 70s;
}
