{
  "name": "chatyemot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "user": "node --env-file-if-exists=.env scripts/user.js",
    "keys": "node scripts/keys.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:browser": "node --env-file-if-exists=.env scripts/browser-test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "web-push": "^3.6.7",
    "yemot-router2": "6.2.3"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}
